{
  "name": "tokenusage",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/tui/*.test.ts tests/tui/*.test.tsx",
    "tui": "tsx src/tui/main.tsx",
    "build:tui": "node scripts/build-tui.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests playwright.config.ts next.config.ts README.md docs",
    "format:check": "prettier --check src scripts tests playwright.config.ts next.config.ts README.md docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "ink": "^8.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "shadcn": "^4.21.4"
  },
  "engines": {
    "node": ">=24"
  }
}
